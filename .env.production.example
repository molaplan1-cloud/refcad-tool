# RefCAD Tool - Production Environment Variables
# Copy this file to .env.local for local development, and set the values
# in Cloudflare Pages / GitHub Actions secrets for production deployment.

# ============================================================
# REQUIRED - Server-side runtime secrets
# ============================================================

# JWT signing secret. Must be at least 32 characters of random data.
# Generate with: openssl rand -hex 32
# Set this in the Vercel project environment. Never commit a real value.
AUTH_SECRET=

# Seeded accounts. Set these in Vercel. The application hashes the passwords
# and does not keep the plaintext. Leave them empty in the repository.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_USERNAME=
DEMO_PASSWORD=

# ============================================================
# OPTIONAL - Application metadata
# ============================================================

# Public URL of the deployed app (used for absolute links in PDFs, emails, etc.)
# Example: https://refcad-tool.pages.dev
NEXT_PUBLIC_APP_URL=https://refcad-tool.pages.dev

# ============================================================
# OPTIONAL - Cloudflare-specific
# ============================================================

# Set by Cloudflare automatically, but useful for local testing
# CF_PAGES=1
# CF_PAGES_BRANCH=master
# CF_PAGES_COMMIT_SHA=abc123

# ============================================================
# OPTIONAL - Telemetry / debugging
# ============================================================

# Disable Next.js telemetry in CI/production
NEXT_TELEMETRY_DISABLED=1

# Node environment
NODE_ENV=production

# ============================================================
# DEVELOPMENT NOTES
# ============================================================
#
# Local development:
#   1. Copy this file: cp .env.production.example .env.local
#   2. Fill in AUTH_SECRET with a local random string
#   3. Run: npm run dev
#
# Cloudflare Pages deployment:
#   - Dashboard: Settings > Environment variables > Add variable
#   - Production environment: AUTH_SECRET, NEXT_PUBLIC_APP_URL
#
# GitHub Actions deployment:
#   - Repo > Settings > Secrets and variables > Actions > New repository secret
#   - Required: AUTH_SECRET, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
#   - CLOUDFLARE_API_TOKEN needs "Cloudflare Pages: Edit" permission
#   - CLOUDFLARE_ACCOUNT_ID is on the Cloudflare dashboard right sidebar
